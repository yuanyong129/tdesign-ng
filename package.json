{
  "name": "tdesign-ng-monorepo",
  "version": "0.0.0",
  "description": "TDesign for Angular",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "pnpm --filter @tdesign-ng/docs run start",
    "build": "pnpm run gen:api && pnpm run build:icons && pnpm run build:lib && pnpm run build:styles && pnpm run build:docs",
    "build:lib": "ng-packagr -p packages/ng-components/ng-package.json",
    "build:icons": "ng-packagr -p packages/icons/ng-package.json",
    "build:styles": "node scripts/build-styles.mjs",
    "build:docs": "pnpm --filter @tdesign-ng/docs run build",
    "build:docs:pages": "pnpm --filter @tdesign-ng/docs run build:pages",
    "gen:api": "node scripts/gen-api-docs.mjs",
    "gen:demos": "node scripts/gen-demo-sources.mjs",
    "check:demos": "node scripts/gen-demo-sources.mjs --check",
    "gen:icons": "node scripts/gen-icons.mjs",
    "check:api": "node scripts/gen-api-docs.mjs --check",
    "check:icons": "node scripts/gen-icons.mjs --check",
    "check:align": "node scripts/align-check.mjs",
    "vendor:styles": "node scripts/vendor-tdesign-common.mjs",
    "preview:pages": "node scripts/preview-pages.mjs"
  },
  "devDependencies": {
    "@angular/compiler-cli": "^19.2.0",
    "less": "^4.5.1",
    "ng-packagr": "^19.2.0",
    "typescript": "~5.7.2"
  }
}
